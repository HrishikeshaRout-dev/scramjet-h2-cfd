FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      chemistryProperties;
}

chemistryType
{
    solver          ode;
}

chemistry           on;
initialChemicalTimeStep 1e-10;

odeCoeffs
{
    solver          seulex;
    absTol          1e-12;
    relTol          1e-3;
}
