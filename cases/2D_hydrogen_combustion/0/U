FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (1791 0 0);

boundaryField
{
    airInlet
    {
        type            fixedValue;
        value           uniform (1791 0 0);
    }

    fuelInlets
    {
        type            flowRateInletVelocity;
        volumetricFlowRate constant 5.616e-4;
        value           uniform (0 0 0);
    }

    lowerWall
    {
        type            noSlip;
    }

    upperWall
    {
        type            noSlip;
    }

    outlet
    {
        type            zeroGradient;
    }

    frontAndBack
    {
        type            empty;
    }
}
