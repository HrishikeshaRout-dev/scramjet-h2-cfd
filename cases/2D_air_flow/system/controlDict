FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

application     rhoCentralFoam;

startFrom       latestTime;
stopAt          endTime;

endTime         1e-6;
deltaT          1e-10;

writeControl    adjustableRunTime;
writeInterval   1e-7;
purgeWrite      0;
writeFormat     binary;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   8;
runTimeModifiable true;

adjustTimeStep  yes;
maxCo           0.05;
maxDeltaT       1e-8;
