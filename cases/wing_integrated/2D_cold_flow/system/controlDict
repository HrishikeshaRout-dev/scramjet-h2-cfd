FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

application     rhoCentralFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;

endTime         1e-5;
deltaT          1e-10;

writeControl    adjustableRunTime;
writeInterval   1e-6;
purgeWrite      0;
writeFormat     binary;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   8;
runTimeModifiable true;

adjustTimeStep  yes;
maxCo           0.2;
maxDeltaT       1e-8;
