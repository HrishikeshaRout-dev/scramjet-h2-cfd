FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    airInlet
    {
        type            uniformFixedValue;
        uniformValue    table
        (
            (0 (0 0 0))
            (1e-7 (1791 0 0))
        );
        value           uniform (0 0 0);
    }

    lowerWall
    {
        type            slip;
    }

    upperWall
    {
        type            slip;
    }

    outlet
    {
        type            zeroGradient;
    }

    frontAndBack
    {
        type            empty;
    }
}
