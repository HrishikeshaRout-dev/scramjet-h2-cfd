FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      N2;
}

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0.7671;

boundaryField
{
    airInlet { type fixedValue; value uniform 0.7671; }
    fuelInlets { type fixedValue; value uniform 0.0; }
    lowerWall { type zeroGradient; }
    upperWall { type zeroGradient; }
    outlet
    {
        type inletOutlet;
        inletValue uniform 0.7671;
        value uniform 0.7671;
    }
    frontAndBack { type empty; }
}
